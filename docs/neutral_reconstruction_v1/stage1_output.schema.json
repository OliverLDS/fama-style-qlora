                  "from_claim": {
                    "type": "string"
                  },
                  "to_claim": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "associated_with",
                      "causes",
                      "compares",
                      "conditions",
                      "contrasts_with",
                      "defines",
                      "enables",
                      "explains",
                      "prevents",
                      "supports"
