{
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string"
    },
    "original_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_audit": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "usable",
            "uncertain",
            "unusable"
          ]
        },
        "transcription_verification": {
          "const": "not_performed"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "transcription",
                  "boundary",
                  "missing_context",
                  "technical_meaning",
                  "other"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "evidence",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "transcription_verification",
        "issues"
      ],
      "additionalProperties": false
    },
    "brief": {
