{
  "$comment": "CPU validator also checks point-reference bounds, self-relations, duplicate primary/secondary roles, and source_problem notes.",
  "$id": "urn:fama-style:brief-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brief": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "key_points": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "purpose": {
          "additionalProperties": false,
          "properties": {
            "primary": {
              "enum": [
                "introduce_topic",
                "define_concept",
                "describe_phenomenon",
                "explain_mechanism",
                "explain_difference",
                "compare_accounts",
                "report_result",
                "describe_method",
                "introduce_data",
                "provide_background",
                "illustrate_case",
                "state_problem",
                "draw_implication",
                "qualify_claim",
                "evaluate_argument",
                "recommend_action",
                "outline_paper",
                "mixed_or_uncertain"
              ],
              "type": "string"
            },
            "reader_takeaway": {
              "minLength": 1,
              "type": "string"
            },
            "secondary": {
              "items": {
                "enum": [
                  "introduce_topic",
                  "define_concept",
                  "describe_phenomenon",
                  "explain_mechanism",
                  "explain_difference",
                  "compare_accounts",
                  "report_result",
                  "describe_method",
                  "introduce_data",
                  "provide_background",
                  "illustrate_case",
                  "state_problem",
                  "draw_implication",
                  "qualify_claim",
                  "evaluate_argument",
                  "recommend_action",
                  "outline_paper",
                  "mixed_or_uncertain"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "primary",
            "secondary",
            "reader_takeaway"
          ],
          "type": "object"
        },
        "relationships": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from_point": {
                "pattern": "^K[1-9][0-9]*$",
                "type": "string"
              },
              "qualification": {
                "type": "string"
              },
              "to_point": {
                "pattern": "^K[1-9][0-9]*$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "cause",
                  "association",
                  "contrast",
                  "condition",
                  "temporal_sequence",
                  "evidence_for",
                  "definition_part",
                  "qualification",
                  "alternative"
                ],
                "type": "string"
              }
            },
            "required": [
              "from_point",
              "to_point",
              "type",
              "qualification"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "task": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task",
        "purpose",
        "key_points",
        "anchors",
        "relationships"
      ],
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "ready",
        "source_problem"
      ],
      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "target_sha256",
    "brief",
    "status",
    "notes"
  ],
  "title": "Purpose-aware content brief v2",
  "type": "object"
}
