# Public allowlist: all unlisted root entries stay local by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/AGENTS.md
!/pyproject.toml
!/requirements-kaggle.txt
!/train.py

!/src/
/src/**
!/src/**/
!/src/**/*.py
!/src/**/*.md
!/src/fama_style/evaluation/templates/*.html

!/scripts/
/scripts/**
!/scripts/**/
!/scripts/**/*.py
!/scripts/data/extract_comparison_ocr.swift
!/scripts/data/extract_author_pages.swift

!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py

!/kaggle/
/kaggle/*
!/kaggle/*.ipynb
!/kaggle/README.md

!/data/
/data/*
!/data/README.md
!/data/historical/
/data/historical/*
!/data/historical/train.example.jsonl
!/data/fama_corpus_v1/
/data/fama_corpus_v1/*
!/data/fama_corpus_v1/rewrite_instruction.txt

!/docs/
!/docs/**
!/.github/
!/.github/**

# Defense in depth: credentials, local settings, caches and model artifacts.
/research_runs/
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/
**/.env
**/.env.*
**/.netrc
**/kaggle.json
**/credentials.json
**/*credentials*.json
**/*.pem
**/*.key
**/*.private.*
**/*.log
**/*.pdf
**/*.safetensors
**/*.pt
**/*.pth
**/*.bin
**/tokenizer.json
**/.venv/
**/node_modules/
**/*.egg-info/
**/.pytest_cache/
